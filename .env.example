# Installation Docker seulement, sans Home Assistant OS. L'app se configure
# dans Home Assistant et n'utilise pas ce fichier.

# Adresse locale de Home Assistant, pour rester 100 % en local.
HA_URL=http://192.168.1.10:8123

# Jeton longue durée : profil Home Assistant > Sécurité > Jetons d'accès longue durée.
HA_TOKEN=

# Mot de passe SIP partagé entre Asterisk et l'adaptateur téléphonique.
# Lettres et chiffres uniquement : openssl rand -hex 16
SIP_PASSWORD=

# Réseau local autorisé à joindre Asterisk. Tout le reste est refusé.
LAN_CIDR=192.168.1.0/24

# 0.0.0.0 seulement le temps d'un test à l'émulateur depuis le LAN.
VIDEOTEX_BIND=127.0.0.1
